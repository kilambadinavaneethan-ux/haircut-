# ==============================================================================
# QuickCut Customer App - Environment Configuration Example
# ==============================================================================
# Option 1: Point to your Cloud Supabase project (Reachable from anywhere/Expo Go)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Option 2: Point to local Supabase running on your PC (Use PC's Wi-Fi LAN IP, not localhost)
# Example: If your PC's IP is 10.151.143.212
# EXPO_PUBLIC_SUPABASE_URL=http://10.151.143.212:54321
# EXPO_PUBLIC_SUPABASE_ANON_KEY=your-local-anon-key

{
  "name": "quickcut-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "QuickCut - Real-time Barber Shop Queue Management Platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:all": "node scripts/dev-all.js",
    "dev:admin": "npm run dev --workspace=@quickcut/admin",
    "dev:owner": "npm run dev --workspace=@quickcut/owner",
    "dev:customer": "npm run start:lan --workspace=@quickcut/customer",
    "dev:customer:tunnel": "npm run start:tunnel --workspace=@quickcut/customer",
    "dev:staff": "npm run start:lan --workspace=@quickcut/staff",
    "dev:staff:tunnel": "npm run start:tunnel --workspace=@quickcut/staff",
    "build:shared": "npm run build --workspace=@quickcut/shared",
    "build:admin": "npm run build --workspace=@quickcut/admin",
    "build:owner": "npm run build --workspace=@quickcut/owner",
    "build:all": "npm run build:shared && npm run build:admin && npm run build:owner",
    "db:start": "npx supabase start",
    "db:reset": "npx supabase db reset",
    "db:seed": "npx supabase db seed",
    "db:types": "npx supabase gen types typescript --local > packages/shared/src/types/database.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "clean": "rimraf **/node_modules **/dist **/.expo"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "prettier": "^3.9.10",
    "qrcode-terminal": "^0.12.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5",
    "zod": "^4.6.7"
  }
}
